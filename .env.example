# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Optional; defaults to the operating system's temporary directory.
# PROCESSING_DIR=/tmp/codebase-explorer
QUERY_RATE_LIMIT=30/minute
INGEST_RATE_LIMIT=5/hour

# Optional single-user login. Set all three values to enable authentication.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
AUTH_SECRET=
AUTH_TOKEN_HOURS=12

# Language model
GEMINI_API_KEY=
# Optional failover key from a different Google Cloud project.
GEMINI_API_KEY_BACKUP=
# Optional: enables cloning supported private GitHub repositories.
GITHUB_TOKEN=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Supabase backend credentials (never expose the secret key to React)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

SUPABASE_SOURCE_BUCKET=project-sources
