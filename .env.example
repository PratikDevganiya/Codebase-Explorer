# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
QUERY_RATE_LIMIT=30/minute
INGEST_RATE_LIMIT=5/hour

# Language model
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Supabase backend credentials (never expose the secret key to React)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

SUPABASE_SOURCE_BUCKET=project-sources
